{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OverChat",
  "version": "0.6.0",
  "identifier": "app.overchat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OverChat — настройки",
        "url": "index.html",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "backgroundColor": "#121318"
      },
      {
        "label": "overlay",
        "title": "OverChat — чат",
        "url": "overlay.html",
        "width": 340,
        "height": 420,
        "minWidth": 200,
        "minHeight": 140,
        "x": 40,
        "y": 160,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://static-cdn.jtvnw.net https://cdn.7tv.app; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OverChat",
    "shortDescription": "OverChat",
    "longDescription": "Чат Twitch поверх игры",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    }
  }
}
